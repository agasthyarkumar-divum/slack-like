# For running the backend directly on the host (uvicorn app.main:app --reload)
# against the db/redis containers from `docker-compose up db redis`.
# Copy to backend/.env. For the full docker-compose stack, use the root .env instead.

APP_NAME=Divum Chat
APP_VERSION=0.1.0
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://company_chat:change-me@localhost:5432/company_chat
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
# Throwaway dev key — generate your own for anything beyond localhost:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=HfswfsAVd0EUICWD5my7GOCEy4ibsq-3zQfMMUIJ29E=

COMPANY_NAME=Divum
COMPANY_SLACK_NAME=Divum Chat

CORS_ORIGINS=["*"]
