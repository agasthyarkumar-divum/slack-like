# Copy to .env and fill in real secrets before running docker-compose up.
# Never commit the real .env file.

# --- App identity (drives FastAPI title, mobile display name, etc.) ---
APP_NAME=Divum Chat
APP_VERSION=0.1.0
APP_ENV=development

# --- Postgres ---
POSTGRES_USER=company_chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=company_chat
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend API ---
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://company_chat:change-me@db:5432/company_chat
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- File storage (StorageBackend, architecture.md §2) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/srv/company-chat/uploads
# Fernet key (32 url-safe base64 bytes) for encrypt-at-rest in LocalFileSystemBackend.
# The value below is a throwaway dev key — generate your own for anything beyond
# localhost: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=HfswfsAVd0EUICWD5my7GOCEy4ibsq-3zQfMMUIJ29E=

# --- S3 (unused until STORAGE_BACKEND=s3) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# --- Push notifications (FCM, stubbed until Phase 9) ---
FCM_SERVER_KEY=
FCM_CREDENTIALS_JSON_PATH=

# --- CORS --- (JSON array — pydantic-settings parses list fields as JSON)
CORS_ORIGINS=["*"]
