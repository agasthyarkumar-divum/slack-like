# Copy to web/.env. VITE_-prefixed vars are inlined into the client bundle at
# build time (same convention as mobile/.env's EXPO_PUBLIC_ prefix).

# localhost works when you're opening the web app from the same machine the
# backend is running on. Inside a container/VM whose ports are forwarded to
# your actual browser (GitHub Codespaces, a remote dev box, etc.), the
# browser's "localhost" means *your* machine, not the container — point this
# at the backend's forwarded/public URL instead, e.g.
# VITE_API_URL=https://<codespace-name>-8000.app.github.dev
VITE_API_URL=http://localhost:8000
