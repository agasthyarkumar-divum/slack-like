# Copy to mobile/.env. EXPO_PUBLIC_-prefixed vars are inlined into the client
# bundle at build time (Expo's equivalent of Next.js's NEXT_PUBLIC_ convention).

# localhost works for the iOS simulator and the web preview (`npx expo start --web`).
# A physical device via Expo Go needs your host machine's LAN IP instead, e.g.
# EXPO_PUBLIC_API_URL=http://10.0.10.97:8000 — Expo prints that IP on `expo start`.
# Android emulator (not a physical device): use http://10.0.2.2:8000.
EXPO_PUBLIC_API_URL=http://localhost:8000
